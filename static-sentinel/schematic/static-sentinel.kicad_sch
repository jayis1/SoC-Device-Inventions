(kicad_sch (version 20230121) (generator "jayis1")
  (uuid 421c4297-844e-45b9-a182-21756f592219) (paper "A4")
  (title_block (title "Static Sentinel") (company "jayis1")
    (comment 1 "USB-powered ESD-workstation reference monitor")
    (comment 2 "Reference schematic; ERC must be run before fabrication"))
  (lib_symbols)
  (text "POWER: J1 USB-C VBUS -> F1 0.5A PTC -> D1 5V TVS -> U4 AP2112K-3.3 -> +3V3" (at 15.24 25.4 0))
  (text "USB-C: CC1 and CC2 each use 5.1k Rd to GND; no USB data or PD negotiation is used." (at 15.24 33.02 0))
  (text "U1 ESP32-C6-WROOM-1-N8: GPIO6 SDA / GPIO7 SCL -> U2 SHT45 and U3 ADS1115; R5/R6 4.7k pull-ups to +3V3." (at 15.24 40.64 0))
  (text "MAT TEST: GPIO2 -> R1 1M -> J3 MAT+; J3 return -> R3 100k -> ADS1115 AIN0. Guard ring follows AIN0." (at 15.24 48.26 0))
  (text "STRAP TEST: GPIO2 -> R2 1M -> J4 STRAP+; J4 return -> R4 100k -> ADS1115 AIN1. Never exceed 3.3V." (at 15.24 55.88 0))
  (text "GPIO0 MAT_SENSE, GPIO1 STRAP_SENSE reserved for optional direct ADC calibration; GPIO3 BUZZER, GPIO4 LED, GPIO5 BUTTON." (at 15.24 63.5 0))
  (text "Place 100nF at U1/U2/U3/U4 VDD pins; C6/C7 10uF at USB input and 3V3 rail. Keep RF antenna copper-free." (at 15.24 71.12 0))
  (text "All external bench terminals are SELV low-voltage sensing only. Add enclosure strain relief and ESD-rated connector layout." (at 15.24 78.74 0))
  (sheet_instances (path "/") (page "1"))
)
