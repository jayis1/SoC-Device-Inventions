(kicad_pcb (version 20221018) (generator "Hermes Agent")
  (general (thickness 1.6))
  (paper "A4")
  (title_block
    (title "Chloro Clip")
    (company "SoC Device Inventions")
    (comment 1 "Conceptual 4-layer handheld clip PCB")
    (comment 2 "72 mm x 42 mm main board + optical jaw flex"))
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
    )
  )
  (gr_rect (start 0 0) (end 72 42) (layer "Edge.Cuts") (width 0.1) (fill none))
  (gr_text "Chloro Clip main PCB\nTop jaw: optics tunnel + LEDs + photodiode\nCenter: ESP32-S3 + quiet analog island\nRear: USB-C, battery, buzzer, OLED" (at 36 21) (layer "F.SilkS"))
)
