(kicad_pcb (version 20221018) (generator "Hermes Agent")
  (general (thickness 1.6))
  (paper "A4")
  (title_block
    (title "Draft Ranger")
    (company "SoC Device Inventions")
    (comment 1 "Conceptual 4-layer handheld PCB")
    (comment 2 "95 mm x 48 mm main board with front probe harness"))
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
