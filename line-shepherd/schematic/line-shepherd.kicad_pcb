(kicad_pcb (version 20231120) (generator "Hermes Agent")
  (general
    (thickness 1.6)
  )
  (paper "A4")
  (title_block
    (title "Line Shepherd")
    (comment 1 "Conceptual 4-layer handheld PCB placeholder")
    (comment 2 "Keep launch bridge and comparator compact")
  )
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user)
    (41 "Cmts.User" user)
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user)
    (47 "F.CrtYd" user)
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )
  (setup
    (pad_to_mask_clearance 0)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros false)
      (usegerberextensions false)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
      (svguseinch false)
      (svgprecision 4)
      (plotframeref false)
      (viasonmask false)
      (mode 1)
      (useauxorigin false)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (pdf_front_fp_property_popups true)
      (pdf_back_fp_property_popups true)
      (pdf_metadata true)
    )
  )
  (gr_rect (start 20 20) (end 120 80)
    (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts")
  )
  (gr_text "Top edge: RJ45 + terminal block + surge protection" (at 30 30 0) (layer "Dwgs.User")
    (effects (font (size 1.5 1.5) (thickness 0.2))))
  (gr_text "Center: launch bridge, THS3201, ADCMP600, STM32" (at 30 40 0) (layer "Dwgs.User")
    (effects (font (size 1.5 1.5) (thickness 0.2))))
  (gr_text "Bottom: battery, charger, OLED, ESP32-C3, microSD" (at 30 50 0) (layer "Dwgs.User")
    (effects (font (size 1.5 1.5) (thickness 0.2))))
)
