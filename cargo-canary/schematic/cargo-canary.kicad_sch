(kicad_sch (version 20231120) (generator eeschema)
  (uuid 3f77a2e5-6cac-4aef-a3d1-2ccddd128301)
  (paper "A4")
  (title_block (title "Cargo Canary cold-chain shipment tag") (date "2026-09-26") (rev "A") (company "jayis1") (comment 1 "Reference design; validate symbols, footprints, RF, ERC and DRC before fabrication"))
  (lib_symbols)
  (text "POWER: ER34615 3V6 -> F1 0.75A PTC -> D1 SMF5.0A -> TPS62745 3V3\nMODEM rail: ER34615 -> TPS22919 (switched) -> BG95-M3; 470uF low-ESR reservoir at modem" (exclude_from_sim no) (at 25.4 25.4 0) (effects (font (size 1.5 1.5) (thickness 0.25)) (justify left bottom)))
  (text "U1 nRF52840-QIAA-R: P0.26/P0.27 I2C_SDA/I2C_SCL -> U6 TCA9548A; P0.13/P0.14/P0.15 SPI -> U7 W25Q128 + DISP1 IL0373; P0.21/P0.22 UART -> 1.8V translator -> U2 BG95-M3; P0.25 LIS2DW12_INT; P0.11 TAMPER_N; P0.31 VBAT_SENSE." (exclude_from_sim no) (at 25.4 45.72 0) (effects (font (size 1.5 1.5) (thickness 0.25)) (justify left bottom)))
  (text "I2C channels: U6 CH0 -> U3 SHT45 (0x44); U6 CH1 -> U5 OPT3001 (0x44); controller bus -> U4 LIS2DW12 (0x19). 4k7 pull-ups to 3V3 on controller and enabled channels. 100nF local decoupling per IC; 10uF bulk per rail." (exclude_from_sim no) (at 25.4 63.5 0) (effects (font (size 1.5 1.5) (thickness 0.25)) (justify left bottom)))
  (text "RF: U2 BG95-M3 LTE-M/NB-IoT -> ANT1 FXP830 LTE antenna; GNSS -> ANT2 active patch. Use 4-layer controlled-impedance layout, modem vendor reference circuit, antenna keep-outs, and review before ordering." (exclude_from_sim no) (at 25.4 81.28 0) (effects (font (size 1.5 1.5) (thickness 0.25)) (justify left bottom)))
  (text "Inputs: SW1 normally-closed reed tamper to P0.11; U4 motion interrupt to P0.25; SW2 wake button to P0.12. Outputs: DISP1 2.13in e-paper, LED1 status. Programming: SWDIO/SWCLK fixture pads only." (exclude_from_sim no) (at 25.4 99.06 0) (effects (font (size 1.5 1.5) (thickness 0.25)) (justify left bottom)))
  (text_box "CONCEPTUAL CONNECTIVITY SHEET\nThis native KiCad schematic source documents circuit nets and component references but intentionally does not claim library-symbol validation. Recreate verified symbols from manufacturer data, then replace this reference sheet with production symbols and run ERC before fabrication." (exclude_from_sim no) (at 25.4 119.38 0) (size 152.4 25.4) (stroke (width 0.5) (type default) (fill (type none))) (fill (type background)) (effects (font (size 2 2) (thickness 0.3)) (justify left top)))
