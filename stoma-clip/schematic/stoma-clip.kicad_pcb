(kicad_pcb (version 20221018) (generator "Hermes Agent")
  (general (thickness 1.6))
  (paper "A4")
  (title_block
    (title "Stoma Clip")
    (company "SoC Device Inventions")
    (comment 1 "Conceptual 4-layer handheld PCB")
    (comment 2 "92 mm x 54 mm main board + leaf clip interposer"))
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
