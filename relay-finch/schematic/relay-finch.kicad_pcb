(kicad_pcb (version 20231120) (generator "Hermes Agent")
  (general
    (thickness 1.6)
  )
  (paper "A4")
  (title_block
    (title "Relay Finch")
    (comment 1 "Pocket relay and solenoid signature analyzer"))
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0)
  )
  (gr_rect (start 20 20) (end 120 80)
    (stroke (width 0.1) (type default)) (fill no) (layer "Edge.Cuts"))
  (gr_text "Relay Finch prototype PCB placeholder\nAnalog front end left, radio keep-out right, DUT connectors on edge" (at 70 50)
    (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.2))))
)
